<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuración base: solo HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Configuración específica para el dominio de producción -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.maxximundo.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>